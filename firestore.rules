rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cuenta → doctor: medicos/{correo} = { doctor: 'd1' } o { admin: true }
    function perfil() {
      return get(/databases/$(database)/documents/medicos/$(request.auth.token.email.lower())).data;
    }
    function esDe(doctor) {
      return request.auth != null && (perfil().get('doctor', '') == doctor || perfil().get('admin', false) == true);
    }

    match /medicos/{correo} {
      allow read: if request.auth != null && request.auth.token.email.lower() == correo;
    }

    // Servicios que realiza cada doctor: la web los lee, solo ese doctor los cambia
    match /agenda/{doctor} {
      allow read: if true;
      allow create, update: if doctor in ['d1', 'd2', 'd3'] && esDe(doctor)
        && request.resource.data.keys().hasOnly(['servicios', 'actualizado'])
        && request.resource.data.servicios is list
        && request.resource.data.servicios.size() <= 40;
    }

    // Horas ocupadas de cada doctor: la web las lee, solo ese doctor las cambia
    match /agenda/{doctor}/ocupado/{fecha} {
      allow read: if true;
      allow write: if esDe(doctor);
    }

    // Notas de pacientes: privadas, solo ese doctor
    match /agenda/{doctor}/notas/{fecha} {
      allow read, write: if esDe(doctor);
    }

    // Solicitudes de cita: el paciente las crea sin cuenta; solo su doctor las ve y las responde
    match /citas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['doctor', 'servicio', 'fecha', 'hora', 'turno', 'nombre', 'celular', 'comentario', 'estado', 'creada'])
        && request.resource.data.doctor in ['d1', 'd2', 'd3']
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.creada == request.time
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 80
        && request.resource.data.celular is string && request.resource.data.celular.matches('9[0-9]{8}')
        && request.resource.data.servicio is string && request.resource.data.servicio.size() <= 80
        && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 400
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.hora is number
        && request.resource.data.turno in ['manana', 'tarde', 'noche']
        // va junto con la marca de su celular (máximo una solicitud por número cada 24 horas)
        && getAfter(/databases/$(database)/documents/limite/$(request.resource.data.celular)).data.cita == id
        && getAfter(/databases/$(database)/documents/limite/$(request.resource.data.celular)).data.ultima == request.time;
      // El paciente guarda el id de su cita (aleatorio, imposible de adivinar) para ver si se aprobó
      allow get: if true;
      allow list: if esDe(resource.data.doctor);
      allow update: if esDe(resource.data.doctor)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respondida'])
        && request.resource.data.estado in ['aprobada', 'rechazada'];
    }

    function marcaValida(celular) {
      return request.resource.data.keys().hasOnly(['ultima', 'cita', 'libre', 'rechazos', 'dia', 'bloqueoHasta'])
        && request.resource.data.get('libre', false) == false
        && request.resource.data.ultima == request.time
        && request.resource.data.cita is string
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.cita)).data.celular == celular;
    }
    function citaDeMarca() {
      return get(/databases/$(database)/documents/citas/$(resource.data.cita)).data;
    }
    // Última solicitud de cada celular: { ultima, cita, libre, rechazos, dia, bloqueoHasta }
    // Solo se crea o renueva junto con una cita nueva. Renovarla exige que hayan pasado 24 horas
    // o que el doctor haya rechazado la anterior (libre), y nunca antes de bloqueoHasta.
    match /limite/{celular} {
      allow get: if esDe(citaDeMarca().doctor);
      allow create: if celular.matches('9[0-9]{8}') && marcaValida(celular)
        && request.resource.data.keys().hasOnly(['ultima', 'cita', 'libre']);
      allow update: if marcaValida(celular)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultima', 'cita', 'libre'])
        && (resource.data.get('libre', false) == true || request.time > resource.data.ultima + duration.value(24, 'h'))
        && request.time > resource.data.get('bloqueoHasta', timestamp.value(0))
      // El doctor rechaza esa cita: el número queda libre y se cuenta el rechazo del día
      // (al tercer rechazo del día queda bloqueado hasta la medianoche: bloqueoHasta)
        || (esDe(citaDeMarca().doctor)
          && citaDeMarca().estado == 'rechazada'
          && resource.data.get('libre', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['libre', 'rechazos', 'dia', 'bloqueoHasta'])
          && request.resource.data.libre == true
          && request.resource.data.rechazos is int
          && request.resource.data.rechazos >= 1 && request.resource.data.rechazos <= resource.data.get('rechazos', 0) + 1
          && request.resource.data.dia is string
          && request.resource.data.get('bloqueoHasta', request.time) is timestamp
          && request.resource.data.get('bloqueoHasta', request.time) <= request.time + duration.value(25, 'h'));
    }

    // Pedir unirse al turno de otro doctor
    match /solicitudes/{id} {
      allow read: if true;
      allow create: if esDe(request.resource.data.de)
        && request.resource.data.estado in ['pendiente', 'abierto']
        && request.resource.data.turno in ['manana', 'tarde', 'noche'];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respondida'])
        && ((esDe(resource.data.para) && resource.data.estado == 'pendiente' && request.resource.data.estado in ['aceptada', 'rechazada'])
          || (esDe(resource.data.de) && request.resource.data.estado == 'cancelada'));
    }
  }
}
